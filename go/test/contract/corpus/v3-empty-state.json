{
  "entries": [
    { "id": "v3.system.status",            "request": { "method": "GET", "path": "/api/v3/system/status" },
      "normalize": { "redact_paths": ["$.startupPath", "$.appData", "$.osName", "$.osVersion", "$.runtimeName", "$.runtimeVersion", "$.startTime", "$.buildTime", "$.version", "$.databaseVersion", "$.databaseType", "$.databaseHost", "$.urlBase", "$.runtimeArchitecture", "$.osIsDocker", "$.deploymentMethod"] } },
    { "id": "v3.system.routes",            "request": { "method": "GET", "path": "/api/v3/system/routes" } },
    { "id": "v3.system.health",            "request": { "method": "GET", "path": "/api/v3/health" } },
    { "id": "v3.system.tasks",             "request": { "method": "GET", "path": "/api/v3/system/task" },
      "normalize": { "redact_paths": ["$[*].lastExecution", "$[*].nextExecution", "$[*].lastStartTime", "$[*].id"] } },

    { "id": "v3.config.host",              "request": { "method": "GET", "path": "/api/v3/config/host" },
      "normalize": { "redact_paths": ["$.apiKey", "$.instanceName"] } },
    { "id": "v3.config.naming",            "request": { "method": "GET", "path": "/api/v3/config/naming" } },
    { "id": "v3.config.mediamanagement",   "request": { "method": "GET", "path": "/api/v3/config/mediamanagement" } },
    { "id": "v3.config.ui",                "request": { "method": "GET", "path": "/api/v3/config/ui" } },
    { "id": "v3.config.downloadclient",    "request": { "method": "GET", "path": "/api/v3/config/downloadclient" } },
    { "id": "v3.config.indexer",           "request": { "method": "GET", "path": "/api/v3/config/indexer" } },

    { "id": "v3.qualityprofile",           "request": { "method": "GET", "path": "/api/v3/qualityprofile" } },
    { "id": "v3.qualityprofile.schema",    "request": { "method": "GET", "path": "/api/v3/qualityprofile/schema" } },
    { "id": "v3.qualitydefinition",        "request": { "method": "GET", "path": "/api/v3/qualitydefinition" } },
    { "id": "v3.delayprofile",             "request": { "method": "GET", "path": "/api/v3/delayprofile" } },
    { "id": "v3.releaseprofile",           "request": { "method": "GET", "path": "/api/v3/releaseprofile" } },
    { "id": "v3.customformat",             "request": { "method": "GET", "path": "/api/v3/customformat" } },
    { "id": "v3.customformat.schema",      "request": { "method": "GET", "path": "/api/v3/customformat/schema" } },
    { "id": "v3.autotagging",              "request": { "method": "GET", "path": "/api/v3/autotagging" } },
    { "id": "v3.autotagging.schema",       "request": { "method": "GET", "path": "/api/v3/autotagging/schema" } },

    { "id": "v3.series.list",              "request": { "method": "GET", "path": "/api/v3/series" } },
    { "id": "v3.episode.list",             "request": { "method": "GET", "path": "/api/v3/episode", "query": { "seriesId": ["1"] } } },
    { "id": "v3.episodefile.list",         "request": { "method": "GET", "path": "/api/v3/episodefile", "query": { "seriesId": ["1"] } } },
    { "id": "v3.history",                  "request": { "method": "GET", "path": "/api/v3/history" } },
    { "id": "v3.queue",                    "request": { "method": "GET", "path": "/api/v3/queue" } },
    { "id": "v3.queue.status",             "request": { "method": "GET", "path": "/api/v3/queue/status" } },
    { "id": "v3.blocklist",                "request": { "method": "GET", "path": "/api/v3/blocklist" } },
    { "id": "v3.calendar",                 "request": { "method": "GET", "path": "/api/v3/calendar", "query": { "start": ["2026-01-01"], "end": ["2026-12-31"] } } },
    { "id": "v3.wanted.missing",           "request": { "method": "GET", "path": "/api/v3/wanted/missing" } },
    { "id": "v3.wanted.cutoff",            "request": { "method": "GET", "path": "/api/v3/wanted/cutoff" } },

    { "id": "v3.indexer.list",             "request": { "method": "GET", "path": "/api/v3/indexer" } },
    { "id": "v3.indexer.schema",           "request": { "method": "GET", "path": "/api/v3/indexer/schema" } },
    { "id": "v3.downloadclient.list",      "request": { "method": "GET", "path": "/api/v3/downloadclient" } },
    { "id": "v3.downloadclient.schema",    "request": { "method": "GET", "path": "/api/v3/downloadclient/schema" } },
    { "id": "v3.notification.list",        "request": { "method": "GET", "path": "/api/v3/notification" } },
    { "id": "v3.notification.schema",      "request": { "method": "GET", "path": "/api/v3/notification/schema" } },
    { "id": "v3.importlist.list",          "request": { "method": "GET", "path": "/api/v3/importlist" } },
    { "id": "v3.importlist.schema",        "request": { "method": "GET", "path": "/api/v3/importlist/schema" } },
    { "id": "v3.metadata.list",            "request": { "method": "GET", "path": "/api/v3/metadata" } },
    { "id": "v3.metadata.schema",          "request": { "method": "GET", "path": "/api/v3/metadata/schema" } },

    { "id": "v3.rootfolder",               "request": { "method": "GET", "path": "/api/v3/rootfolder" } },
    { "id": "v3.remotepathmapping",        "request": { "method": "GET", "path": "/api/v3/remotepathmapping" } },
    { "id": "v3.diskspace",                "request": { "method": "GET", "path": "/api/v3/diskspace" },
      "normalize": { "redact_paths": ["$[*].path", "$[*].label", "$[*].freeSpace", "$[*].totalSpace"] } },
    { "id": "v3.tag",                      "request": { "method": "GET", "path": "/api/v3/tag" } },
    { "id": "v3.tag.detail",               "request": { "method": "GET", "path": "/api/v3/tag/detail" } },
    { "id": "v3.customfilter",             "request": { "method": "GET", "path": "/api/v3/customfilter" } },
    { "id": "v3.localization",             "request": { "method": "GET", "path": "/api/v3/localization" } },
    { "id": "v3.localization.language",    "request": { "method": "GET", "path": "/api/v3/localization/language" } },
    { "id": "v3.language",                 "request": { "method": "GET", "path": "/api/v3/language" } },
    { "id": "v3.log",                      "request": { "method": "GET", "path": "/api/v3/log", "query": { "page": ["1"], "pageSize": ["10"] } },
      "normalize": { "redact_paths": ["$.records[*].time", "$.records[*].id", "$.records[*].exception", "$.records[*].message", "$.records[*].method", "$.records[*].logger", "$.totalRecords"] } },
    { "id": "v3.update",                   "request": { "method": "GET", "path": "/api/v3/update" } },
    { "id": "v3.command",                  "request": { "method": "GET", "path": "/api/v3/command" },
      "normalize": { "redact_paths": ["$[*].started", "$[*].ended", "$[*].duration", "$[*].stateChangeTime", "$[*].lastExecutionTime", "$[*].id", "$[*].queued"] } }
  ]
}
